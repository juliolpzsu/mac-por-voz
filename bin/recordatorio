#!/bin/zsh
# Crea un recordatorio en la app Recordatorios.
#   recordatorio "texto" ["AAAA-MM-DD HH:MM"] [--lista "Nombre"]
texto=""; cuando=""; lista=""
while (( $# )); do
  case "$1" in
    --lista) lista="$2"; shift 2 ;;
    *) if [[ -z "$texto" ]]; then texto="$1"; else cuando="$1"; fi; shift ;;
  esac
done
[[ -z "$texto" ]] && { echo "Uso: recordatorio \"texto\" [\"AAAA-MM-DD HH:MM\"] [--lista \"Nombre\"]" >&2; exit 1; }
fecha_as=""
if [[ -n "$cuando" ]]; then
  if [[ "$cuando" =~ '^([0-9]{4})-([0-9]{2})-([0-9]{2})( ([0-9]{1,2}):([0-9]{2}))?$' ]]; then
    y=$match[1]; m=$match[2]; d=$match[3]; h=${match[5]:-9}; mi=${match[6]:-0}
    fecha_as="set f to current date
set year of f to $y
set month of f to ${m#0}
set day of f to ${d#0}
set hours of f to ${h#0}
set minutes of f to ${mi#0}
set seconds of f to 0"
  else
    echo "Fecha no reconocida: $cuando (usa AAAA-MM-DD HH:MM)" >&2; exit 1
  fi
fi
t="${texto//\\/\\\\}"; t="${t//\"/\\\"}"
l="${lista//\"/\\\"}"
osascript <<OSA
tell application "Reminders"
  $( [[ -n "$l" ]] && echo "set destino to list \"$l\"" || echo "set destino to default list" )
  $fecha_as
  set r to make new reminder in destino with properties {name:"$t"}
  $( [[ -n "$fecha_as" ]] && echo 'set remind me date of r to f
  set due date of r to f' )
  return name of destino
end tell
OSA
